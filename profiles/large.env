# Perfil large — referência 8 vCPU · 8 GB RAM · +200 equipamentos ou coleta
# massiva concorrente (vários coletores empurrando backup ao mesmo tempo).
# 400 portas passivas: revise a ACL e o NAT 1:1 do host antes de subir.
FTP_MAX_CLIENTS=300
FTP_MAX_CLIENTS_PER_IP=24
FTP_PASSIVE_PORT_START=30000
FTP_PASSIVE_PORT_END=30399
FTP_MEMORY_LIMIT=1G
FTP_CPU_LIMIT=4.0
FTP_PIDS_LIMIT=512
FTP_NOFILE=65536
